pipeline{
    agent any
    parameters{
        booleanParam(name:'RUN_PYTEST_ALLURE',defaultValue:true,description:'运行pytest+allure测试')
    }
    environment {
        JAVA_HOME = 'D:/cxdownload/java'
        PATH = "${JAVA_HOME}/bin;${env.PATH}"
        PYTHON_PATH = 'C:/Users/31276/AppData/Local/Programs/Python/Python310/python.exe'
        RUOYI_HOME = 'D:/Git/RuoYi'
    }
    tools {
        allure 'allure'
    }
    stages{
        stage("拉取最新代码"){
            steps{
                bat 'git fetch origin master'
                bat 'git reset --hard origin/master'
            }
        }
        stage("安装依赖"){
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{
                bat '"%PYTHON_PATH%" -m pip install pytest allure-pytest requests faker selenium'
            }
        }
        stage("启动若依服务"){
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{
                script {
                    // 后台启动若依服务
                    bat 'start /B java -jar "%RUOYI_HOME%/ruoyi-admin/target/ruoyi-admin.jar" --server.port=8088'
                    // 等待服务启动
                    sleep(time: 30, unit: 'SECONDS')
                    // 检查服务是否启动成功
                    bat 'curl -s -o nul -w "%{http_code}" http://localhost:8088/login || echo 服务未启动'
                }
            }
        }
        stage("执行登录测试"){
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{
                bat '"%PYTHON_PATH%" -m pytest pageO/test_login.py -v --alluredir=allure-results/login --clean-alluredir'
            }
        }
        stage("执行用户管理测试"){
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{
                bat '"%PYTHON_PATH%" -m pytest pageO/test_user_ui.py -v --alluredir=allure-results/user --clean-alluredir'
            }
        }
        stage("执行faker_ddt接口测试"){
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{
                bat '"%PYTHON_PATH%" -m pytest RuoYi/faker_ddt/test_faker_ddt.py -v --alluredir=allure-results/faker --clean-alluredir'
            }
        }
        stage("生成allure报告"){
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{
                withEnv(["JAVA_HOME=D:/cxdownload/java"]) {
                    allure includeProperties: false, jdk: '', results: [
                        [path: 'allure-results/login'],
                        [path: 'allure-results/user'],
                        [path: 'allure-results/faker']
                    ]
                }
            }
        }
    }
    post {
        always {
            bat 'echo 测试完成'
            // 关闭若依服务
            bat 'taskkill /F /IM java.exe 2>nul || echo 无java进程'
        }
        failure {
            bat 'echo 测试失败，请检查日志'
        }
    }
}

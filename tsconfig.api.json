{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./api/dist",
    "rootDir": "./api",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "allowImportingTsExtensions": false,
    "declaration": false,
    "sourceMap": false,
    "paths": {}
  },
  "include": ["api/**/*"],
  "exclude": ["api/dist"]
}

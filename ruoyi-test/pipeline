pipeline{ 
    agent any 
    parameters{ 
        booleanParam(name:'RUN_PYTEST_ALLURE',defaultValue:true,description:'运行pytest+allure测试') 
    } 
    environment { 
        JAVA_HOME = 'D:\\cxdownload\\java' 
        PATH = "\\\bin;\" 
    } 
    tools { 
        allure 'allure' 
    } 
    stages{ 
        stage("拉取最新代码"){ 
            steps{ 
                bat 'git fetch origin master' 
                bat 'git reset --hard origin/master' 
            } 
        } 
        stage("安装依赖"){ 
            when { expression { params.RUN_PYTEST_ALLURE==true } } 
            steps{ 
                bat 'C:\\Users\\31276\\AppData\\Local\\Programs\\Python\\Python310\\python.exe -m pip install pytest allure-pytest selenium' 
            } 
        } 
        stage("执行pytest生成allure数据"){ 
            when { expression { params.RUN_PYTEST_ALLURE==true } } 
            steps{ 
                bat 'C:\\Users\\31276\\AppData\\Local\\Programs\\Python\\Python310\\python.exe -m pytest test_login.py -v --alluredir=allure-results --clean-alluredir' 
            } 
        } 
        stage("生成allure报告"){ 
            when { expression { params.RUN_PYTEST_ALLURE==true } } 
            steps{ 
                withEnv(["JAVA_HOME=D:\\cxdownload\\java"]) { 
                    allure includeProperties: false, jdk: '', results: [[path: 'allure-results']] 
                } 
            } 
        } 
    } 
}
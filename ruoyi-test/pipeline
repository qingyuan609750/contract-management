pipeline{ 
    agent any 
    parameters{ 
        booleanParam(name:'RUN_PYTEST_ALLURE',defaultValue:true,description:'运行pytest+allure测试')
    } 
    environment {
        JAVA_HOME = 'D:\\cxdownload\\java'
        PATH = "${JAVA_HOME}\\bin;${env.PATH}"
    }
    tools {
        allure 'allure'
    }
    stages{ 
        stage("安装依赖"){ 
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{ 
                bat 'C:\\Users\\31276\\AppData\\Local\\Programs\\Python\\Python310\\python.exe -m pip install pytest allure-pytest selenium' 
            } 
        } 
        stage("执行pytest生成allure数据"){ 
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{ 
                bat 'cd D:\\Git\\RuoYi\\ruoyi-test\\pythonProject2\\RuoYi && C:\\Users\\31276\\AppData\\Local\\Programs\\Python\\Python310\\python.exe -m pytest test_login.py -v --alluredir=allureresults --clean-alluredir' 
            } 
        } 
        stage("生成allure报告"){ 
            when { expression { params.RUN_PYTEST_ALLURE==true } }
            steps{ 
                allure includeProperties: false, jdk: '', results: [[path: 'D:\\Git\\RuoYi\\ruoyi-test\\pythonProject2\\RuoYi\\allureresults']]
            } 
        } 
    } 
}